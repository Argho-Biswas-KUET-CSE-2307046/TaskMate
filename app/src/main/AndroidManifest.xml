<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet permission for Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Notification permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground Service permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Exact alarm permission -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Receive notification after device restart -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Keep CPU awake during alarm playback -->
    <uses-permission
        android:name="android.permission.WAKE_LOCK" />


    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="TaskMate"
        android:supportsRtl="true"
        android:theme="@style/Theme.TaskMate">


        <!-- Main launcher activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>


        <!-- Authentication activities -->
        <activity
            android:name=".SignUpActivity"
            android:exported="false" />

        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false" />

        <activity
            android:name=".ResetPasswordActivity"
            android:exported="false" />


        <!-- Dashboard and task activities -->
        <activity
            android:name=".TaskActivity"
            android:exported="false" />

        <activity
            android:name=".TasksActivity"
            android:exported="false" />

        <activity
            android:name=".AddTaskActivity"
            android:exported="false" />

        <activity
            android:name=".TaskDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".EditTaskActivity"
            android:exported="false" />

        <activity
            android:name=".ProgressActivity"
            android:exported="false" />


        <!-- Profile activity -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />


        <!-- Focus Timer activity -->
        <activity
            android:name=".FocusTimerActivity"
            android:exported="false" />


        <!-- Focus Timer foreground service -->
        <service
            android:name=".FocusTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a user-started focus countdown and alarm." />

        </service>


        <!-- Receives scheduled timer alarms -->
        <receiver
            android:name=".AlarmReceiver"
            android:enabled="true"
            android:exported="false" />


        <!-- Restores timer after device restart -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>

        </receiver>


    </application>

</manifest>
