<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F6FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="JSON and XML Parser"
            android:textColor="#21164B"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnParseJson"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Parse JSON" />

        <Button
            android:id="@+id/btnParseXml"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Parse XML"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Parsing Result"
            android:textColor="#21164B"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="25dp" />

        <TextView
            android:id="@+id/tvParsingResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="200dp"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:text="Your parsing result will appear here."
            android:textColor="#30204E"
            android:textSize="15sp"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</ScrollView>
