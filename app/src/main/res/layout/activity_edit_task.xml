<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5FF"
    android:fillViewport="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants"
    android:scrollbars="vertical"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Clickable Page Header -->
        <TextView
            android:id="@+id/tvEditBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="‹     Edit Task"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#39216B"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingVertical="12dp"
            android:layout_marginBottom="22dp" />

        <!-- Basic Information Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_task_detail_card"
            android:elevation="3dp"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Basic Information"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#39216B"
                android:layout_marginBottom="16dp" />

            <!-- Task Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Task Title *"
                android:textColor="#454052"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <EditText
                android:id="@+id/etTaskTitle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_task_input"
                android:paddingHorizontal="14dp"
                android:hint="Enter task title"
                android:textColor="#24164A"
                android:textColorHint="#A49BB5"
                android:inputType="textCapSentences"
                android:singleLine="true"
                android:layout_marginBottom="16dp" />

            <!-- Description -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textColor="#454052"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <EditText
                android:id="@+id/etTaskDescription"
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:background="@drawable/bg_task_input"
                android:padding="14dp"
                android:gravity="top|start"
                android:hint="Describe your task"
                android:textColor="#24164A"
                android:textColorHint="#A49BB5"
                android:inputType="textCapSentences|textMultiLine" />

        </LinearLayout>

        <!-- Schedule and Priority Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_task_detail_card"
            android:elevation="3dp"
            android:padding="18dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Schedule and Priority"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#39216B"
                android:layout_marginBottom="16dp" />

            <!-- Due Date -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Due Date *"
                android:textColor="#454052"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <EditText
                android:id="@+id/etDueDate"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_task_input"
                android:paddingHorizontal="14dp"
                android:hint="Select due date"
                android:textColor="#24164A"
                android:textColorHint="#A49BB5"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true"
                android:cursorVisible="false"
                android:layout_marginBottom="16dp" />

            <!-- Due Time -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Due Time"
                android:textColor="#454052"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <EditText
                android:id="@+id/etDueTime"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_task_input"
                android:paddingHorizontal="14dp"
                android:hint="Select due time"
                android:textColor="#24164A"
                android:textColorHint="#A49BB5"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true"
                android:cursorVisible="false"
                android:layout_marginBottom="16dp" />

            <!-- Priority -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Priority"
                android:textColor="#454052"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <Spinner
                android:id="@+id/spPriority"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_task_input"
                android:paddingHorizontal="10dp" />

        </LinearLayout>

        <!-- Category and Reminder Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_task_detail_card"
            android:elevation="3dp"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Category and Reminder"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#39216B"
                android:layout_marginBottom="16dp" />

            <!-- Category -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textColor="#454052"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <Spinner
                android:id="@+id/spCategory"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_task_input"
                android:paddingHorizontal="10dp"
                android:layout_marginBottom="16dp" />

            <!-- Reminder -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reminder"
                android:textColor="#454052"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <Spinner
                android:id="@+id/spReminder"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_task_input"
                android:paddingHorizontal="10dp" />

        </LinearLayout>

        <!-- Update Button -->
        <Button
            android:id="@+id/btnUpdateTask"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Update Task"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/bg_task_primary_button"
            android:backgroundTint="@null"
            android:elevation="2dp" />

        <!-- Cancel Button -->
        <Button
            android:id="@+id/btnCancelEdit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Cancel"
            android:textColor="#59309C"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:background="@drawable/bg_task_secondary_button"
            android:backgroundTint="@null"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>
