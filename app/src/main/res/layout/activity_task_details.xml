<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="‹     Task Details"
            android:textColor="#39216B"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:layout_marginBottom="22dp" />

        <!-- Task Description Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_task_detail_card"
            android:elevation="3dp"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvTaskTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Task Title"
                android:textColor="#24164A"
                android:textSize="23sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textColor="#7652B5"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <TextView
                android:id="@+id/tvTaskDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Task description"
                android:textColor="#625D70"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

        <!-- Task Information Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_task_detail_card"
            android:elevation="3dp"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Task Information"
                android:textColor="#39216B"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- Due Date -->
            <TextView
                android:id="@+id/tvDueDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Due Date: Not set"
                android:textColor="#454052"
                android:textSize="15sp"
                android:paddingVertical="10dp" />

            <!-- Due Time -->
            <TextView
                android:id="@+id/tvDueTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Due Time: Not set"
                android:textColor="#454052"
                android:textSize="15sp"
                android:paddingVertical="10dp" />

            <!-- Priority -->
            <TextView
                android:id="@+id/tvPriority"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Priority: Medium"
                android:textColor="#454052"
                android:textSize="15sp"
                android:paddingVertical="10dp" />

            <!-- Category -->
            <TextView
                android:id="@+id/tvCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Category: Other"
                android:textColor="#454052"
                android:textSize="15sp"
                android:paddingVertical="10dp" />

            <!-- Reminder -->
            <TextView
                android:id="@+id/tvReminder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reminder: No reminder"
                android:textColor="#454052"
                android:textSize="15sp"
                android:paddingVertical="10dp" />

            <!-- Status -->
            <TextView
                android:id="@+id/tvTaskStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Pending"
                android:textColor="#6533B5"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_task_secondary_button"
                android:paddingHorizontal="15dp"
                android:paddingVertical="9dp"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <!-- Edit Button -->
        <Button
            android:id="@+id/btnEditTask"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Edit Task"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/bg_task_primary_button"
            android:backgroundTint="@null"
            android:elevation="2dp" />

        <!-- Complete Button -->
        <Button
            android:id="@+id/btnMarkCompleted"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Mark as Completed"
            android:textColor="#59309C"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/bg_task_secondary_button"
            android:backgroundTint="@null"
            android:layout_marginTop="12dp" />

        <!-- Back Button -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Back"
            android:textColor="#625D70"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:backgroundTint="#E9E5F1"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>
